{
  "name": "outbox-backend",
  "version": "1.0.0",
  "description": "Production-grade Email Job Scheduler Backend",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "worker": "tsx watch src/workers/email.worker.ts",
    "worker:prod": "node dist/workers/email.worker.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "seed:senders": "tsx src/db/seed-senders.ts",
    "seed:dev": "tsx src/db/seed-dev-user.ts",
    "reindex": "tsx src/scripts/reindex.ts",
    "test": "jest",
    "loadtest": "tsx src/scripts/loadtest.ts"
  },
  "dependencies": {
    "@bull-board/api": "^6.0.0",
    "@bull-board/express": "^6.0.0",
    "@elastic/elasticsearch": "^8.13.0",
    "@prisma/client": "^6.4.0",
    "bullmq": "^5.41.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.5.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.10.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.5",
    "@types/nodemailer": "^6.4.17",
    "jest": "^29.7.0",
    "prisma": "^6.4.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
