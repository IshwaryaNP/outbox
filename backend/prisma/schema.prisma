datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum EmailStatus {
  scheduled
  processing
  sent
  failed
}

model User {
  id         String            @id @default(uuid())
  googleId   String            @unique
  email      String            @unique
  name       String
  avatar     String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  slack      SlackConnection?
  senders    Sender[]
  campaigns  Campaign[]
  emails     Email[]
}

model SlackConnection {
  id          String   @id @default(uuid())
  userId      String   @unique
  teamId      String
  accessToken String
  webhookUrl  String?
  channel     String?
  connectedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Sender {
  id        String   @id @default(uuid())
  email     String   @unique
  smtpHost  String
  smtpPort  Int
  smtpUser  String
  smtpPass  String
  userId    String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  emails    Email[]
}

model Campaign {
  id          String   @id @default(uuid())
  userId      String
  subject     String
  body        String
  startTime   DateTime
  delayMs     Int
  hourlyLimit Int
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails      Email[]
}

model Email {
  id          String      @id @default(uuid())
  campaignId  String
  userId      String
  senderId    String
  recipient   String
  subject     String
  body        String
  scheduledAt DateTime
  sentAt      DateTime?
  status      EmailStatus @default(scheduled)
  attempts    Int         @default(0)
  error       String?
  messageId   String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender   Sender   @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@unique([campaignId, recipient])
  @@index([status, scheduledAt])
  @@index([userId, status])
}
